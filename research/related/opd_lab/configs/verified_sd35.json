{
  "backend": "sd3",
  "method": "verified",
  "dataset": "data/demo/joint.jsonl",
  "split": "train",
  "seed": 42,
  "resolution": 512,
  "steps": 10,
  "guidance_scale": 4.5,
  "max_sequence_length": 256,
  "precision": "fp16",
  "teachers": ["ocr", "geneval"],
  "teacher_guidance": {"ocr": 4.5, "geneval": 1.0},
  "alphas": [0.5, 1.0],
  "fixed_teacher": "ocr",
  "fixed_alpha": 1.0,
  "utility_joint_weight": 0.5,
  "min_gain": 0.0,
  "quality_floor": null,
  "quality_drop_tolerance": null,
  "outer_epochs": 100,
  "queries_per_rank": 12,
  "accumulation": 12,
  "fitting_epochs": 1,
  "timestep_fraction": 0.99,
  "learning_rate": 0.0003,
  "adam_betas": [0.9, 0.999],
  "weight_decay": 0.0001,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "lora_rank": 32,
  "lora_alpha": 64,
  "initial_adapter": null,
  "ema_decay": 0.9,
  "ema_interval": 8,
  "save_every": 10,
  "audit_postfit": true
}
