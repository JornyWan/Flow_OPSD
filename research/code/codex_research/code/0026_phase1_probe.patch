+# ===== CODEX-0026: Phase-1 probe 的辅助函数 =====
+# 机制已由 code/0025_probe_machinery_test.py 合成验证(快照/还原含 optimizer state、
+# 真实 AdamW proposal 而非 -lr*g、同缓存状态精确重算、certificate 用精确值判定)。
+def _p1_restore(params, theta0):
+    """把参数还原到 theta0(不动 optimizer state;那个在每趟开始前单独还原)。"""
+    with torch.no_grad():
+        for q, t in zip(params, theta0):
+            q.copy_(t)
+
+
+def _p1_flat(ts):
+    return torch.cat([t.reshape(-1).double() for t in ts])
+
+
+def _p1_proj_delta(alpha, names, C, A, delta_adam, out):
+    """解带 repair RHS 的 update-space 投影,返回 Delta(与参数同形状的列表)。
+
+    backtrack **只缩放 reward 分量**:对 alpha*Delta_adam 重解 QP,repair 分量保持全量。
+    整体缩放会把 repair 一并削弱,C>0 时线性模型下注定失败(预注册附录 A)。
+    """
+    if delta_adam is None or any(n not in A for n in names):
+        return None
+    import importlib.util as _il, os as _os
+    _root = _os.environ.get("CODEX_ROOT", "")
+    _sp = _il.spec_from_file_location("_qp", _os.path.join(_root, "code", "0025_qp_repair_solver.py"))
+    _qp = _il.module_from_spec(_sp); _sp.loader.exec_module(_qp)
+    fa = {n: _p1_flat(A[n]) for n in names}
+    fd = _p1_flat(delta_adam)
+    aa = [[float(fa[i] @ fa[j]) for j in names] for i in names]
+    ad = [float(alpha * (fa[i] @ fd)) for i in names]
+    Cv = [C[i] for i in names]
+    mu, act = _qp.solve_repair_qp(aa, ad, Cv)
+    out[f"mu@{alpha}"] = mu
+    out[f"active@{alpha}"] = act
+    if mu is None:
+        return None
+    delta = [alpha * d.detach().clone().double() for d in delta_adam]
+    for k, n in enumerate(names):
+        if mu[k] == 0.0:
+            continue
+        for t, a in zip(delta, A[n]):
+            t.sub_(mu[k] * a.double())
+    # retention 的分母始终是**全量** Delta_adam,使 alpha<1 如实体现为下降
+    out[f"retention@{alpha}"] = float((_p1_flat(delta) @ fd) / (fd @ fd)) if float(fd @ fd) != 0 else float("nan")
+    return [t.to(d.dtype) for t, d in zip(delta, delta_adam)]
+
+
