+# CODEX-0002: direct PickScore improvement with external-teacher retention
+# constraints.  This is intentionally a control-flow smoke configuration, not
+# a performance run.  The released Student is mandatory because the retention
+# baseline is defined relative to that exact initialization.
+def codex_cr_smoke():
+    # CODEX-0018: smoke 只能用于验证代码正确与否,绝不能产出任何测量值或结论。
+    # 0015/0016 曾因守卫查 codex_cr_prod、启动行写死 codex_cr_smoke 而静默跑了 smoke 数据,
+    # 守卫全绿但结论全部作废。此处在**被启动的进程内**硬性拦住,外部守卫做不到这件事。
+    if os.environ.get("OPD_ALLOW_SMOKE", "") != "1":
+        raise ValueError("codex_cr_smoke 仅供代码正确性验证;确需运行必须显式设 OPD_ALLOW_SMOKE=1")
+    config = mopd()
+    _init = os.environ.get("OPD_STUDENT_INIT", "").strip()
+    _run_dir = os.environ.get("CODEX_CR_RUN_DIR", "").strip()
+    if not _init:
+        raise ValueError("CODEX-0002 requires OPD_STUDENT_INIT")
+    if not _run_dir:
+        raise ValueError("CODEX-0002 requires CODEX_CR_RUN_DIR")
+
+    config.train.lora_path = _init
+    config.train.rtc = True
+    config.train.rtc_precond = "raw"
+    config.train.rtc_sigma = 0.278
+    config.train.rtc_rho = 0.10
+    config.train.rtc_nascent = 2
+    config.train.rtc_beta = 0.5
+    config.train.rtc_dual = True
+    config.train.rtc_margin = 0.0
+    config.train.itopd_reward_fn = "pickscore"
+
+    config.train.constrained_retention = True
+    config.train.cr_reward_teacher_idx = 0
+    config.train.cr_retention_teacher_indices = [1, 2]
+    config.train.cr_rel_tol = float(os.environ.get("CODEX_CR_REL_TOL", "0.02"))
+    config.train.cr_abs_tol = float(os.environ.get("CODEX_CR_ABS_TOL", "1e-8"))
+    config.train.cr_direct_weight = float(os.environ.get("CODEX_CR_DIRECT_WEIGHT", "1.0"))
+    config.train.cr_retention_weight = float(os.environ.get("CODEX_CR_RETENTION_WEIGHT", "1.0"))
+
+    # Keep three semantically named slots and their real external teachers, but
+    # use the same tiny prompt set and no asynchronous proxy scorers.  The smoke
+    # tests optimization plumbing; it does not estimate task performance.
+    _tiny = "/midtier/minilab/scratch/chw4026/projects/side_project/generative/opd_related/testdata/pickscore"
+    for _tc in config.train.teachers:
+        _tc["dataset"] = _tiny
+        _tc["prompt_fn"] = "general_ocr"
+        _tc["proxy_reward"] = {}
+    config.num_epochs = int(os.environ.get("OPD_NUM_EPOCHS", "3"))
+    config.eval_freq = 0
+    config.save_freq = 1
+    config.run_name = "[CODEX-0002-CR-SMOKE]"
+    config.save_dir = _run_dir
+    config.save_eval_dir = os.path.join(_run_dir, "eval_images")
+    return config
